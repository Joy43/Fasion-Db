{
  "expo": {
    "name": "fasion-DB",
    "slug": "fasion-DB",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/fasiondb.png",
    "scheme": "fasiondb",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.fasionDB",
       "UIBackgroundModes": ["remote-notification"]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/fasiondb.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [],
      "package": "com.anonymous.fasionDB"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/fasiondb.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "react-native-video",
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3c870566-cf77-4f1b-950b-eb842403ca36"
      }
    }
  }
}
